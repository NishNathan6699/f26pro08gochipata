
extends layout

block content
  h1= title
  p Welcome to my WA Lab 10 Express application.

  button(type="button", class="btn btn-secondary", onclick="reduce()") Sample Button

  div#use Take some away

  p
    a(href="/hikingtrails") View Hiking Trails
  p
    a(href="/grid?rows=6&cols=5") View Grid
  p
    a(href="/selector") Choose Random Trails

  script.
    let current = 11;
    let quantity = 2;

    function reduce() {
      current = current - quantity;
      if (current < 0) {
        current = 0;
      }
      document.getElementById("use").innerHTML =
        `Reduced by ${quantity} to ${current}`;
    }
