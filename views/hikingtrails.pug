
extends layout

block content
  h1= title
  p Available Hiking Trails

  - let items = results

  div.container-fluid
    div.row
      each item, index in items
        div.col-sm-2.border.rounded.p-3.m-2(onclick=`buy(${index})`, style="cursor:pointer")
          h5 #{item.name}
          p Location: #{item.location}
          p Distance: #{item.length} miles
          p Difficulty: #{item.difficulty}
      else
        p No hiking trails found.

  script.
    function buy(index) {
      alert(`You purchased item ${index}`);
    }
