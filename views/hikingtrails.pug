
extends layout

block content
  h1= title
  p Available Hiking Trails
  a.btn.btn-primary.mb-3(href='/hikingtrails/create') Add Trail

  - let items = results

  div.container-fluid
    div.row
      each item, index in items
        div.col-12.col-md-5.col-xl-3.border.rounded.p-3.m-2
          h5 #{item.name}
          p Location: #{item.location}
          p Distance: #{item.length} miles
          p Difficulty: #{item.difficulty}
          .d-flex.gap-2.flex-wrap
            a.btn.btn-outline-primary(href='/hikingtrails/' + item._id) Inspect
            a.btn.btn-outline-secondary(href='/hikingtrails/' + item._id + '/update') Update
            a.btn.btn-outline-danger(href='/hikingtrails/' + item._id + '/delete') Delete
      else
        p No hiking trails found.
